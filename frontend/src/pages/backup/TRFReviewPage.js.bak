// --- src/pages/TRFReviewPage.js (final version with filtering) ---
import React, { useState, useEffect } from 'react';
import api from '../api';
import moment from 'moment';
import { useNavigate } from 'react-router-dom';
import './TeammateLecturer.css'; // Still using your TeammateLecturer.css

function TRFReviewPage({ isGlobal = false }) {
  const [submissions, setSubmissions] = useState([]);
  const [loading, setLoading] = useState(true);
  const navigate = useNavigate();

  // [NEW] Create a new state to hold the filter criteria
  const [statusFilter, setStatusFilter] = useState(''); // Empty by default, which means 'All'

  useEffect(() => {
    const fetchSubmissions = async () => {
      setLoading(true);
      try {
        const url = '/submissions/';
        const params = { view: isGlobal ? 'all' : 'mine' };
        const res = await api.get(url, { params: params });
        
        // Sort by student name, A-Z
        const sortedSubmissions = res.data.sort((a, b) => 
          (a.student_name || '').localeCompare(b.student_name || '')
        );
        
        setSubmissions(sortedSubmissions);

      } catch (err) {
        console.error("Failed to fetch submissions", err);
      } finally {
        setLoading(false);
      }
    };
    fetchSubmissions();
  }, [isGlobal]);

  // [NEW] Filter the submissions to display on the front end using the filter criteria
  const filteredSubmissions = submissions.filter(sub => {
    if (!statusFilter) {
      return true; // With no filter set (statusFilter empty) show everything
    }
    return sub.status === statusFilter;
  });

  return (
    <div className="main-content">
      <header>
        <h1>{isGlobal ? "All TRF Submissions" : "My Students' Submissions"}</h1>
        <p>{isGlobal ? "Review all TRF submissions across the department..." : "Review and manage project submissions assigned to you."}</p>
      </header>

      <div className="card">
        {/* [CORE ADDITION] Add the filter UI above the table */}
        <div className="filters-wrapper">
            <div className="course-filter-container">
                <span>Filter by Stage: </span>
                <button onClick={() => setStatusFilter('')} className={`course-filter-btn ${!statusFilter ? 'active' : ''}`}>All</button>
                <button onClick={() => setStatusFilter('approved')} className={`course-filter-btn ${statusFilter === 'approved' ? 'active' : ''}`}>Approved</button>
                <button onClick={() => setStatusFilter('pending')} className={`course-filter-btn ${statusFilter === 'pending' ? 'active' : ''}`}>Pending</button>
                <button onClick={() => setStatusFilter('revision')} className={`course-filter-btn ${statusFilter === 'revision' ? 'active' : ''}`}>Needs Revision</button>
            </div>
        </div>

        <table>
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Project Title</th>
              <th>Date Submitted</th>
              <th>TRF Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan="5" style={{textAlign: 'center'}}>Loading...</td></tr>
            // [CORE CHANGE] Render from filteredSubmissions
            ) : filteredSubmissions.length === 0 ? (
              <tr><td colSpan="5" style={{textAlign: 'center'}}>No submissions found for the selected filter.</td></tr>
            ) : (
              filteredSubmissions.map(sub => (
                <tr key={sub.id}>
                  <td>{sub.student_name || 'N/A'}</td>
                  <td>{sub.proposed_project_title || 'N/A'}</td>
                  <td>{moment(sub.created_at).format('DD MMM YYYY')}</td>
                  <td>
                    <span className={`status ${sub.status}`}>
                      {sub.status}
                    </span>
                  </td>
                  <td>
                    <button 
                      className={`btn ${sub.status === 'pending' ? 'btn-review' : 'btn-view'}`} 
                      onClick={() => navigate(`/give-feedback/${sub.id}`)}
                    >
                      {sub.status === 'pending' ? 'Review' : 'View Details'}
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}

export default TRFReviewPage;